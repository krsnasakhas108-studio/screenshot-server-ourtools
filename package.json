{
  "name": "screenshot-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm install && node -e \"const p = require('puppeteer'); p.executablePath ? console.log('Chrome found') : null;\"",
    "postinstall": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@sparticuz/chromium": "^123.0.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "21.6.1"
  },
  "engines": {
    "node": "20.x"
  }
}
